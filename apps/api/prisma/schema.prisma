generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------
enum UserRoleType {
  SUPER_ADMIN
  ADMIN
  GERENTE
  CAIXA
  ESTOQUISTA
  VENDEDOR
  FINANCEIRO
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  LOSS
  EXPIRED
  DAMAGE
  INITIAL_BALANCE
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  STORE_CREDIT
  VOUCHER
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELED
  REFUNDED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE
  SUPPLY
  SANGRIA
  REFUND
  CLOSING
}

enum FiscalStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
  CONTINGENCY
}

enum FiscalType {
  NFCE
  NFE
  SAT
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD
}

enum InventoryCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  APPLIED
  CANCELED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  priceMonthly  Decimal  @map("price_monthly") @db.Decimal(12, 2)
  priceYearly   Decimal  @map("price_yearly") @db.Decimal(12, 2)
  maxStores     Int      @default(1) @map("max_stores")
  maxUsers      Int      @default(5) @map("max_users")
  maxProducts   Int      @default(1000) @map("max_products")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique @map("tenant_id")
  planId             String             @map("plan_id")
  billingCycle       BillingCycle       @default(MONTHLY) @map("billing_cycle")
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  autoRenew          Boolean            @default(true) @map("auto_renew")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

// ----------------------------------------------------
// TENANTS & STRUCTURE
// ----------------------------------------------------
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  cnpj      String?
  phone     String?
  email     String?
  plan      String   @default("FREE")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores             Store[]
  users              User[]
  roles              Role[]
  permissions        Permission[]
  products           Product[]
  categories         Category[]
  brands             Brand[]
  units              Unit[]
  suppliers          Supplier[]
  customers          Customer[]
  sales              Sale[]
  cashRegisters      CashRegister[]
  cashSessions       CashSession[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  jobs               Job[]
  accountsPayable    AccountPayable[]
  accountsReceivable AccountReceivable[]
  fiscalDocuments    FiscalDocument[]
  subscription       Subscription?

  @@map("tenants")
}

model Store {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  code      String?
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terminals          Terminal[]
  stockLocations     StockLocation[]
  cashRegisters      CashRegister[]
  sales              Sale[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockLots          StockLot[]
  inventoryCounts    InventoryCount[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  accountsPayable    AccountPayable[]
  accountsReceivable AccountReceivable[]
  fiscalDocuments    FiscalDocument[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("stores")
}

model Terminal {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  storeId   String   @map("store_id")
  name      String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashRegisters CashRegister[]
  sales         Sale[]

  @@unique([storeId, code])
  @@index([tenantId, storeId])
  @@map("terminals")
}

// ----------------------------------------------------
// USERS & RBAC
// ----------------------------------------------------
model User {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  storeId      String?      @map("store_id")
  email        String
  passwordHash String       @map("password_hash")
  name         String
  role         UserRoleType @default(CAIXA)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles          UserRole[]
  sales              Sale[]
  cashSessionsOpened CashSession[]       @relation("OpenedSessions")
  cashSessionsClosed CashSession[]       @relation("ClosedSessions")
  cashMovements      CashMovement[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  stockMovements     StockMovement[]
  openedCounts       InventoryCount[]    @relation("OpenedCounts")
  appliedCounts      InventoryCount[]    @relation("AppliedCounts")
  createdOrders      PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  saleReturns        SaleReturn[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  key         String
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ----------------------------------------------------
// CATALOG & PRODUCTS
// ----------------------------------------------------
model Category {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

model Unit {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  symbol    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, symbol])
  @@index([tenantId])
  @@map("units")
}

model Product {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String?
  sku           String?
  barcode       String?
  categoryId    String?  @map("category_id")
  brandId       String?  @map("brand_id")
  unitId        String?  @map("unit_id")
  costPrice     Decimal  @default(0) @map("cost_price") @db.Decimal(12, 4)
  salePrice     Decimal  @default(0) @map("sale_price") @db.Decimal(12, 4)
  minStock      Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  maxStock      Decimal? @map("max_stock") @db.Decimal(12, 3)
  trackLots     Boolean  @default(false) @map("track_lots")
  ncm           String?
  cest          String?
  cfop          String?
  taxPercentage Decimal  @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand               Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit                Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  additionalBarcodes  ProductBarcode[]
  stockBalances       StockBalance[]
  stockLots           StockLot[]
  stockMovements      StockMovement[]
  inventoryCountItems InventoryCountItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceiptItems   GoodsReceiptItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@index([tenantId, barcode])
  @@index([tenantId, sku])
  @@map("products")
}

model ProductBarcode {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  barcode   String
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, barcode])
  @@index([tenantId, barcode])
  @@index([productId])
  @@map("product_barcodes")
}

// ----------------------------------------------------
// STOCK & INVENTORY
// ----------------------------------------------------
model StockLocation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  storeId   String   @map("store_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockBalances StockBalance[]

  @@unique([storeId, name])
  @@index([tenantId, storeId])
  @@map("stock_locations")
}

model StockBalance {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  storeId    String   @map("store_id")
  locationId String   @map("location_id")
  productId  String   @map("product_id")
  quantity   Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt  DateTime @updatedAt @map("updated_at")

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, locationId, productId])
  @@index([tenantId, storeId, productId])
  @@map("stock_balances")
}

model StockLot {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  storeId           String    @map("store_id")
  productId         String    @map("product_id")
  supplierId        String?   @map("supplier_id")
  lotNumber         String    @map("lot_number")
  manufacturingDate DateTime? @map("manufacturing_date")
  expirationDate    DateTime  @map("expiration_date")
  quantity          Decimal   @default(0) @db.Decimal(12, 3)
  costPrice         Decimal   @default(0) @map("cost_price") @db.Decimal(12, 4)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier            Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockMovements      StockMovement[]
  saleItems           SaleItem[]
  inventoryCountItems InventoryCountItem[]

  @@index([tenantId, storeId, productId])
  @@index([tenantId, expirationDate])
  @@map("stock_lots")
}

model StockMovement {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  storeId       String            @map("store_id")
  productId     String            @map("product_id")
  lotId         String?           @map("lot_id")
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  balanceAfter  Decimal           @map("balance_after") @db.Decimal(12, 3)
  unitCost      Decimal           @default(0) @map("unit_cost") @db.Decimal(12, 4)
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  notes         String?
  userId        String?           @map("user_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  store   Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  lot     StockLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, productId])
  @@index([tenantId, type, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model InventoryCount {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  storeId     String               @map("store_id")
  status      InventoryCountStatus @default(DRAFT)
  notes       String?
  openedById  String               @map("opened_by_id")
  appliedById String?              @map("applied_by_id")
  openedAt    DateTime             @default(now()) @map("opened_at")
  appliedAt   DateTime?            @map("applied_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  store     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  openedBy  User                 @relation("OpenedCounts", fields: [openedById], references: [id])
  appliedBy User?                @relation("AppliedCounts", fields: [appliedById], references: [id])
  items     InventoryCountItem[]

  @@index([tenantId, storeId, status])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  inventoryCountId String   @map("inventory_count_id")
  productId        String   @map("product_id")
  lotId            String?  @map("lot_id")
  expectedQty      Decimal  @map("expected_qty") @db.Decimal(12, 3)
  countedQty       Decimal  @map("counted_qty") @db.Decimal(12, 3)
  difference       Decimal  @db.Decimal(12, 3)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  lot            StockLot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([inventoryCountId])
  @@index([tenantId, productId])
  @@map("inventory_count_items")
}

// ----------------------------------------------------
// PURCHASES & SUPPLIERS
// ----------------------------------------------------
model Supplier {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  tradeName String?  @map("trade_name")
  document  String?
  email     String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  stockLots       StockLot[]
  accountsPayable AccountPayable[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  storeId     String              @map("store_id")
  supplierId  String              @map("supplier_id")
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes       String?
  createdById String              @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy     User                @relation(fields: [createdById], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@index([tenantId, storeId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  purchaseOrderId String   @map("purchase_order_id")
  productId       String   @map("product_id")
  quantity        Decimal  @db.Decimal(12, 3)
  unitCost        Decimal  @map("unit_cost") @db.Decimal(12, 4)
  totalCost       Decimal  @map("total_cost") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  storeId         String   @map("store_id")
  purchaseOrderId String?  @map("purchase_order_id")
  supplierId      String   @map("supplier_id")
  invoiceNumber   String?  @map("invoice_number")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  receivedById    String   @map("received_by_id")
  receivedAt      DateTime @default(now()) @map("received_at")
  createdAt       DateTime @default(now()) @map("created_at")

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receivedBy    User               @relation(fields: [receivedById], references: [id])
  items         GoodsReceiptItem[]

  @@index([tenantId, storeId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  goodsReceiptId String    @map("goods_receipt_id")
  productId      String    @map("product_id")
  quantity       Decimal   @db.Decimal(12, 3)
  unitCost       Decimal   @map("unit_cost") @db.Decimal(12, 4)
  lotNumber      String?   @map("lot_number")
  expirationDate DateTime? @map("expiration_date")
  createdAt      DateTime  @default(now()) @map("created_at")

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

// ----------------------------------------------------
// CUSTOMERS & SALES (POS)
// ----------------------------------------------------
model Customer {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  document    String?
  email       String?
  phone       String?
  address     String?
  creditLimit Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales              Sale[]
  accountsReceivable AccountReceivable[]

  @@index([tenantId, name])
  @@index([tenantId, document])
  @@map("customers")
}

model Sale {
  id             String     @id @default(uuid())
  tenantId       String     @map("tenant_id")
  storeId        String     @map("store_id")
  terminalId     String?    @map("terminal_id")
  cashSessionId  String?    @map("cash_session_id")
  customerId     String?    @map("customer_id")
  userId         String     @map("user_id")
  code           String
  subtotal       Decimal    @db.Decimal(12, 2)
  discount       Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)
  status         SaleStatus @default(COMPLETED)
  idempotencyKey String?    @unique @map("idempotency_key")
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  terminal           Terminal?           @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  cashSession        CashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user               User                @relation(fields: [userId], references: [id])
  items              SaleItem[]
  payments           SalePayment[]
  returns            SaleReturn[]
  fiscalDocuments    FiscalDocument[]
  accountsReceivable AccountReceivable[]

  @@unique([tenantId, code])
  @@index([tenantId, storeId, createdAt])
  @@index([tenantId, status])
  @@index([cashSessionId])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  saleId    String   @map("sale_id")
  productId String   @map("product_id")
  lotId     String?  @map("lot_id")
  quantity  Decimal  @db.Decimal(12, 3)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  costPrice Decimal  @default(0) @map("cost_price") @db.Decimal(12, 4)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  lot             StockLot?        @relation(fields: [lotId], references: [id], onDelete: SetNull)
  saleReturnItems SaleReturnItem[]

  @@index([saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

model SalePayment {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  saleId       String        @map("sale_id")
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  installments Int           @default(1)
  reference    String?
  createdAt    DateTime      @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([tenantId, method, createdAt])
  @@map("sale_payments")
}

model SaleReturn {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  saleId        String   @map("sale_id")
  userId        String   @map("user_id")
  reason        String
  totalRefunded Decimal  @map("total_refunded") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  sale  Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id])
  items SaleReturnItem[]

  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  saleReturnId String   @map("sale_return_id")
  saleItemId   String   @map("sale_item_id")
  productId    String   @map("product_id")
  quantity     Decimal  @db.Decimal(12, 3)
  refundAmount Decimal  @map("refund_amount") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
  @@map("sale_return_items")
}

// ----------------------------------------------------
// CASH MANAGEMENT
// ----------------------------------------------------
model CashRegister {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  storeId    String   @map("store_id")
  terminalId String?  @map("terminal_id")
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  terminal Terminal?     @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  sessions CashSession[]

  @@unique([storeId, name])
  @@index([tenantId, storeId])
  @@map("cash_registers")
}

model CashSession {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  storeId         String            @map("store_id")
  cashRegisterId  String            @map("cash_register_id")
  openedById      String            @map("opened_by_id")
  closedById      String?           @map("closed_by_id")
  status          CashSessionStatus @default(OPEN)
  initialBalance  Decimal           @default(0) @map("initial_balance") @db.Decimal(12, 2)
  expectedBalance Decimal?          @map("expected_balance") @db.Decimal(12, 2)
  reportedBalance Decimal?          @map("reported_balance") @db.Decimal(12, 2)
  difference      Decimal?          @db.Decimal(12, 2)
  justification   String?
  notes           String?
  openedAt        DateTime          @default(now()) @map("opened_at")
  closedAt        DateTime?         @map("closed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  openedBy     User           @relation("OpenedSessions", fields: [openedById], references: [id])
  closedBy     User?          @relation("ClosedSessions", fields: [closedById], references: [id])
  movements    CashMovement[]
  sales        Sale[]

  @@index([tenantId, cashRegisterId, status])
  @@index([tenantId, openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  cashSessionId String           @map("cash_session_id")
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String
  referenceId   String?          @map("reference_id")
  notes         String?
  userId        String           @map("user_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([cashSessionId, type])
  @@map("cash_movements")
}

// ----------------------------------------------------
// FINANCE
// ----------------------------------------------------
model AccountPayable {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  storeId     String          @map("store_id")
  supplierId  String?         @map("supplier_id")
  description String
  amount      Decimal         @db.Decimal(12, 2)
  dueDate     DateTime        @map("due_date")
  paidDate    DateTime?       @map("paid_date")
  status      FinancialStatus @default(PENDING)
  category    String?
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, status, dueDate])
  @@map("accounts_payable")
}

model AccountReceivable {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  storeId      String          @map("store_id")
  customerId   String?         @map("customer_id")
  saleId       String?         @map("sale_id")
  description  String
  amount       Decimal         @db.Decimal(12, 2)
  dueDate      DateTime        @map("due_date")
  receivedDate DateTime?       @map("received_date")
  status       FinancialStatus @default(PENDING)
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, status, dueDate])
  @@map("accounts_receivable")
}

// ----------------------------------------------------
// FISCAL
// ----------------------------------------------------
model FiscalDocument {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  storeId      String       @map("store_id")
  saleId       String?      @map("sale_id")
  type         FiscalType   @default(NFCE)
  number       Int
  series       Int
  key          String?      @unique
  xml          String?      @db.Text
  protocol     String?
  status       FiscalStatus @default(PENDING)
  errorMessage String?      @map("error_message")
  environment  String       @default("homologation")
  issuedAt     DateTime?    @map("issued_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale   Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  events FiscalEvent[]

  @@index([tenantId, storeId, status])
  @@index([tenantId, key])
  @@map("fiscal_documents")
}

model FiscalEvent {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  fiscalDocumentId String   @map("fiscal_document_id")
  eventType        String   @map("event_type")
  protocol         String?
  details          String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  fiscalDocument FiscalDocument @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)

  @@index([fiscalDocumentId])
  @@map("fiscal_events")
}

// ----------------------------------------------------
// AUDIT & LOGS
// ----------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, action])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

// ----------------------------------------------------
// JOBS QUEUE (POSTGRES PERSISTENCE)
// ----------------------------------------------------
model Job {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id")
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  availableAt DateTime  @default(now()) @map("available_at")
  lockedAt    DateTime? @map("locked_at")
  finishedAt  DateTime? @map("finished_at")
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([tenantId, type])
  @@map("jobs")
}

// ----------------------------------------------------
// IDEMPOTENCY KEYS
// ----------------------------------------------------
model IdempotencyKey {
  id         String   @id @default(uuid())
  key        String   @unique
  tenantId   String   @map("tenant_id")
  response   Json?
  statusCode Int?     @map("status_code")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([key, tenantId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
